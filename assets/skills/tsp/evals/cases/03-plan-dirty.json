{
  "name": "03-plan-dirty",
  "prompt": "haz el testing",
  "fixture": "miniapp",
  "plan": "clean",
  "git_init": true,
  "max_turns": 60,
  "timeout_seconds": 1500,
  "mutate_after_baseline": [
    {
      "file": "src/limits.js",
      "find": "return !(n > max);",
      "replace": "return !(n >= max);"
    }
  ],
  "graders": [
    {
      "type": "output_regex",
      "pattern": "limits"
    },
    {
      "type": "tool_regex",
      "pattern": "node --test"
    },
    {
      "type": "section_rows",
      "path": "docs/testing/test-plan.md",
      "section": "Execution log",
      "min": 1
    },
    {
      "type": "file_regex",
      "path": "docs/testing/test-plan.md",
      "section": "Execution log",
      "pattern": "limits"
    }
  ]
}
