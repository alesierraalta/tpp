{
  "name": "10-idempotence",
  "prompt": "haz el testing",
  "fixture": "miniapp",
  "git_init": true,
  "max_turns": 70,
  "timeout_seconds": 1800,
  "graders": [
    {
      "type": "file_exists",
      "path": "docs/testing/test-plan.md"
    },
    {
      "type": "file_regex",
      "path": "docs/testing/test-plan.md",
      "section": "Findings",
      "pattern": "(?i)normaliz"
    },
    {
      "type": "file_regex",
      "path": "docs/testing/test-plan.md",
      "pattern": "(?i)(idempot|applied twice|apply.{0,20}twice|dos veces|normalizePath\\(normalizePath)"
    },
    {
      "type": "findings_have_evidence",
      "path": "docs/testing/test-plan.md"
    }
  ],
  "baseline": true
}