{
  "name": "01-no-plan",
  "prompt": "haz el testing",
  "fixture": "miniapp",
  "git_init": true,
  "baseline": true,
  "max_turns": 60,
  "timeout_seconds": 1500,
  "graders": [
    {
      "type": "file_exists",
      "path": "docs/testing/test-plan.md"
    },
    {
      "type": "file_regex",
      "path": "docs/testing/test-plan.md",
      "pattern": "^\\#\\# Inventory",
      "name": "section Inventory"
    },
    {
      "type": "file_regex",
      "path": "docs/testing/test-plan.md",
      "pattern": "^\\#\\# Ranked targets",
      "name": "section Ranked targets"
    },
    {
      "type": "file_regex",
      "path": "docs/testing/test-plan.md",
      "pattern": "^\\#\\# Layer matrix",
      "name": "section Layer matrix"
    },
    {
      "type": "file_regex",
      "path": "docs/testing/test-plan.md",
      "pattern": "^\\#\\# Execution log",
      "name": "section Execution log"
    },
    {
      "type": "file_regex",
      "path": "docs/testing/test-plan.md",
      "pattern": "^\\#\\# Findings",
      "name": "section Findings"
    },
    {
      "type": "file_regex",
      "path": "docs/testing/test-plan.md",
      "pattern": "^\\#\\# Evidence ledger",
      "name": "section Evidence ledger"
    },
    {
      "type": "section_rows",
      "path": "docs/testing/test-plan.md",
      "section": "Execution log",
      "min": 1
    },
    {
      "type": "output_regex",
      "pattern": "(?i)plan"
    },
    {
      "type": "output_regex",
      "pattern": "(?i)execut"
    },
    {
      "type": "output_not_regex",
      "pattern": "\\?\\s*$",
      "scope": "last_line",
      "name": "no closing question"
    },
    {
      "type": "findings_have_evidence",
      "path": "docs/testing/test-plan.md"
    },
    {
      "type": "no_razonado_in_findings",
      "path": "docs/testing/test-plan.md"
    }
  ]
}
